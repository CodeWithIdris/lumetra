# Supabase Configuration for Lumetra
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.example .env.local

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Public API Key
# Use ONLY the public anon / publishable key in frontend client code.
# NEVER expose a secret key or service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
